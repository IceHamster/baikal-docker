{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Baikal's release version and ZIP SHA-256 together",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-release-attachments) packageName=(?<packageName>[^\\s]+)\\r?\\nARG BAIKAL_VERSION=(?<currentValue>[^\\s]+)\\r?\\nARG BAIKAL_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
